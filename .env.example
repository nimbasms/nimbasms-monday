# --- monday app secrets (Developer Center > Basic Information) ---
# Signe les requetes serveur-a-serveur (blocs d'automatisation, remote options).
MONDAY_SIGNING_SECRET=
# Signe le sessionToken emis par les vues cote client.
MONDAY_CLIENT_SECRET=
# OAuth : necessaire uniquement pour l'ecriture differee des rapports de livraison.
MONDAY_CLIENT_ID=
OAUTH_REDIRECT_URI=

# URL publique du backend, utilisee pour verifier le claim `aud` des JWT monday.
# Sur monday code, c'est l'URL de deploiement. Laisser vide desactive la verif d'audience.
APP_PUBLIC_URL=

# --- API Nimba SMS ---
NIMBA_BASE_URL=https://api.nimbasms.com
NIMBA_SEND_PATH=/v1/messages
NIMBA_SENDERS_PATH=/v1/sendernames
NIMBA_ACCOUNT_PATH=/v1/accounts

# --- divers ---
MONDAY_API_VERSION=2025-10
REQUEST_TIMEOUT_SECONDS=15
DEFAULT_COUNTRY_CODE=224
# DEV_MODE=true : stockage en memoire au lieu du secure storage monday code.
DEV_MODE=false
